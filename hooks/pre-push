#!/bin/sh
#
# Arcade Station pre-push hook.
#
# Enable with:  git config core.hooksPath hooks
#
# Runs the test suite before anything leaves the machine. The suite is
# characterization-first: it pins current behavior so refactors have something
# to fail against. A failure here means behavior moved - decide whether that
# was intended before pushing.
#
# Bypass with --no-verify only when you have a reason you would say out loud.

set -u

PYTHON="python"
if [ -x ".venv/Scripts/python.exe" ]; then
    PYTHON="./.venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PYTHON="./.venv/bin/python"
fi

echo "pre-push: running test suite..."

if ! "$PYTHON" -m pytest -q; then
    echo ""
    echo "pre-push: tests failed. Push blocked."
    echo "  If the behavior change is intended, update the characterization"
    echo "  tests in the same change so the new baseline is explicit."
    exit 1
fi

exit 0
